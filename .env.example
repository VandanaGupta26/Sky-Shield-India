# SkyShield Environment Configuration

# Backend API Configuration
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_PORT=5173

# Weather & Satellite APIs
# Open-Meteo is free and does not require an API key for non-commercial standard usage
OPEN_METEO_API_URL=https://api.open-meteo.com/v1/forecast

# Map Tile Providers (Free standard tiles)
# OpenStreetMap Tile Server
OSM_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
# CartoDB Dark Matter (Recommended for Mission Control aesthetic)
CARTO_DARK_TILE_URL=https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png
# NASA GIBS Tile Server (Optional satellite overlay layers)
NASA_GIBS_TILE_URL=https://gibs.earthdata.nasa.gov/wmts/epsg3857/best

# Simulation Settings
SIMULATION_LATENCY_MS=150
ENABLE_DEMO_STREAM=true
